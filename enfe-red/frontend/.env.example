# Copiá este archivo como .env (desarrollo) o cargá estas variables en el hosting.
# Vite las lee al compilar: si cambiás alguna, volvé a ejecutar npm run build.

# Origen del backend, sin /api al final (por ejemplo https://api.enfered.com.ar).
# En desarrollo, si falta, se usa http://localhost:5000. En producción, si falta,
# se usa el mismo dominio del sitio (sirve si el backend está detrás del mismo dominio).
VITE_API_URL=http://localhost:5000

# Correo de soporte que se muestra en las páginas legales y cuando una cuenta está suspendida.
VITE_SOPORTE_EMAIL=

# Servidor de mosaicos del mapa. Vacío = OpenStreetMap público
# (https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png), que limita el uso intensivo.
VITE_MAPA_TILES_URL=
# Texto de atribución del proveedor del mapa (admite HTML). Vacío = atribución de OpenStreetMap.
VITE_MAPA_ATRIBUCION=

# Servicio de rutas por calles compatible con OSRM (sin barra final).
# Si la línea no está, se usa el servidor de demostración https://router.project-osrm.org/route/v1/driving.
# Si queda vacía (VITE_RUTAS_URL=), el mapa no calcula rutas.
# VITE_RUTAS_URL=https://router.project-osrm.org/route/v1/driving
