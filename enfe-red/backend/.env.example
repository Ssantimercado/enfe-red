# Copiar a .env solo si todavía no existe. No subir credenciales reales.
# Guía de producción completa: backend/DEPLOY.md

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Crear antes la base enfe_red en MySQL y reemplazar usuario/clave.
# Si la clave tiene símbolos (@ : / # %), escribilos codificados (por ejemplo @ = %40).
DATABASE_URL=mysql+pymysql://USUARIO:CLAVE@localhost:3306/enfe_red
# 1 prepara la base (tablas y migraciones) cada vez que arranca la app. Con FLASK_DEBUG=1 y con
# python app.py ya se prepara sola. En producción dejarlo en 0 y correr en cada despliegue:
#   flask --app app preparar-bd
# (1 solo sirve si hay una única instancia del backend).
AUTO_MIGRAR=0
# 1 crea las cuentas demo de enfermeros (laura.gomez@test.com y otras, clave 123456) al preparar la base.
# Solo para pruebas locales; nunca en producción. También: flask --app app cargar-demo
CARGAR_DEMO=0

# ---------------------------------------------------------------------------
# Claves secretas (distintas en cada instalación; nunca las compartas)
# ---------------------------------------------------------------------------
# Obligatoria (mínimo 32 caracteres); sin ella el backend no arranca. Generarla con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_LOCAL_ALEATORIO_DE_32_BYTES_O_MAS
# Cifra el historial médico de los pacientes (Fernet). Obligatoria con FLASK_DEBUG=0; generala con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guardala con cuidado: sin la misma clave los historiales guardados no se pueden leer.
# Con FLASK_DEBUG=1 y vacía, el historial se guarda sin cifrar (se avisa en la consola). Si tu base tiene
# datos reales, configurala también en desarrollo.
CLAVE_CIFRADO_DATOS=
# Solo para cambiar la clave: la vieja va acá (varias, separadas por coma) y después se corre
#   flask --app app recifrar-historiales
# Cuando el comando termina sin historiales pendientes, se deja vacía de nuevo.
CLAVE_CIFRADO_ANTERIOR=

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
# 1 solo en desarrollo: activa recarga automática, debugger, prepara la base al arrancar y muestra en
# consola los correos (como el código de recuperación) cuando SMTP no está configurado. En producción, 0.
FLASK_DEBUG=0
# Puerto donde escucha python serve.py (producción) o python app.py (desarrollo).
PORT=5000
# Hilos de waitress (python serve.py): cuántos pedidos atiende a la vez. 4 alcanza para empezar.
WAITRESS_THREADS=4
# Detalle del registro (logs) que se escribe en la consola: DEBUG, INFO, WARNING, ERROR o CRITICAL.
LOG_LEVEL=INFO
# 1 solo si el sitio se sirve con HTTPS: agrega Strict-Transport-Security (el navegador ya no entra por HTTP).
HTTPS=0
# 1 solo si el backend corre detrás de un proxy propio (nginx, el hosting) que envía X-Forwarded-For.
# Con 1 sin proxy, cualquiera podría inventar su IP y esquivar los límites de intentos.
PROXY_CONFIABLE=0
# Orígenes del frontend autorizados por CORS, separados por coma (sin barra al final).
# Obligatoria con FLASK_DEBUG=0 (por ejemplo https://enfered.example); con FLASK_DEBUG=1 y vacía
# se usa http://localhost:5173.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Sesión
# ---------------------------------------------------------------------------
# El token de acceso dura JWT_ACCESS_MINUTOS (por defecto 60) y el de renovación
# JWT_REFRESH_DIAS (por defecto 30). Cambiar o recuperar la contraseña cierra todas las sesiones.
JWT_ACCESS_MINUTOS=60
JWT_REFRESH_DIAS=30

# ---------------------------------------------------------------------------
# Correo (código de recuperación y avisos)
# ---------------------------------------------------------------------------
# Sin SMTP_HOST no se envía nada: con FLASK_DEBUG=1 el contenido se muestra en la consola y con 0
# solo se registra una advertencia. SMTP_TLS=1 usa STARTTLS (puerto 587); el puerto 465 usa TLS directo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_TLS=1
# Dirección que aparece como remitente (si queda vacía se usa SMTP_USUARIO).
CORREO_REMITENTE=

# ---------------------------------------------------------------------------
# Búsqueda asistida por IA (HU12)
# ---------------------------------------------------------------------------
# reglas (sin IA, por defecto) o gemini. Si la IA falla o no está configurada, se usan las reglas.
IA_PROVEEDOR=reglas
# Gemini: clave de Google AI Studio. Con los créditos de Google AI Pro el uso es pago y no se usa para entrenar.
# Va solo acá, en backend/.env (no se sube): nunca en el frontend ni en un commit. Ver DEPLOY.md.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-flash-lite-latest

# ---------------------------------------------------------------------------
# Copias de seguridad (python scripts/backup_mysql.py)
# ---------------------------------------------------------------------------
# Carpeta de las copias; relativa a backend/ (por defecto backend/backups). Tienen datos personales:
# guardala fuera de la carpeta pública y copiala también a otro lugar.
BACKUP_DIR=backups
# Cuántas copias guardar; las más viejas se borran solas.
BACKUP_CONSERVAR=14
# Ruta a mysqldump si no está en el PATH (en Windows, por ejemplo
# C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe). Vacía usa el del PATH.
MYSQLDUMP=
