# Copiar a .env solo si todavía no existe. No subir credenciales reales.
# Crear antes la base enfe_red en MySQL y reemplazar usuario/clave.
DATABASE_URL=mysql+pymysql://USUARIO:CLAVE@localhost:3306/enfe_red
# Obligatoria (mínimo 32 caracteres); sin ella el backend no arranca. Generarla con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_LOCAL_ALEATORIO_DE_32_BYTES_O_MAS
PORT=5000
# 1 solo en desarrollo: activa recarga automática, debugger y el código de recuperación en consola.
FLASK_DEBUG=1
# HU12 búsqueda asistida por IA: reglas (sin IA, por defecto), gemini u ollama.
# Si la IA falla o no está configurada, se usan las reglas automáticamente.
IA_PROVEEDOR=reglas
# Gemini: clave de Google AI Studio. Con los créditos de Google AI Pro el uso es pago y no se usa para entrenar.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-flash-latest
# Ollama: modelo abierto local (ollama pull qwen3:4b). El texto no sale de la PC.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen3:4b
# Orígenes del frontend autorizados por CORS, separados por coma.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
